# Include host-specific config that is NOT tracked in git
# Put sensitive hosts (IPs, internal infra) in ~/.ssh/config.local
Include ~/.ssh/config.local
# Host-specific entries from the private repo's local-<host> package.
# Placed before Host * so they win under SSH first-match semantics.
Include ~/.ssh/config.d/*.conf

Host github.com
  HostName ssh.github.com
  Port 443

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  ServerAliveInterval 60
  ServerAliveCountMax 5
  IPQoS throughput
  TCPKeepAlive yes
  AddKeysToAgent yes

# Host-specific entries (LAN router IPs, internal device names, etc.) live in
# ~/.ssh/config.local, which is Included above and never tracked in git.
