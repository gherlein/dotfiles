{
    "default_provider": "litellm",
    "default_shape": "local-qwen",
    "providers": {
      "litellm": {
        "type": "openai",
        "base_url": "http://localhost:4000/v1",
        "model": "claude-sonnet"
      }
    },
    "shapes": {
      "claude": {
        "loop": "interactive",
        "provider": "litellm",
        "model": "claude-sonnet"
      },
      "oss-cloud": {
        "loop": "interactive",
        "provider": "litellm",
        "model": "gpt-oss-120b-cloud"
      },
      "local-qwen": {
        "loop": "interactive",
        "provider": "litellm",
        "model": "local-qwen"
      },
      "worker": {
        "loop": "oneshot",
        "provider": "litellm",
        "model": "local-qwen",
        "system": "You are a focused subagent. Do exactly what the task prompt asks using your tools, then reply with a concise result and nothing else.",
        "tools": ["read", "list", "glob"],
        "max_turns": 12
      }
    }
  }
