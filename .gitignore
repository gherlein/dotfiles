*~

# Auto-generated by make refresh
.stow-packages

# Environment and secrets
.env
.envrc

# Backup files
*~
*.bak
*.backup
*.orig

# OS files
.DS_Store
Thumbs.db

# Vim swap files
*.swp
*.swo

# Editor files
.vscode/
.idea/

# Logs
*.log

# Local overrides (not tracked)
.backups/
emacs/elisp/
fzf/.fzf/

# opencode auth (contains credentials)
opencode/.local/share/opencode/auth.json

# Ollama identity private key (authenticates to ollama.com; never publish)
ollama/.ollama/id_ed25519

# pi runtime/credential state (not config)
pi-*/.pi/agent/auth.json
pi-*/.pi/agent/models-store.json

# AI tool runtime transcripts/logs/history (embed private project source)
erg/.config/erg/sessions/
erg/.config/erg/history/
kit/.kit/sessions/
omp/.omp/logs/

# Binary prompt databases (LMDB; may hold personal/work prompts)
gram/.config/gram/prompts/
zed/.config/zed/prompts/

# LLM context (per global policy)
.llm/

# Superpowers execution scratch (ledgers, briefs, review packages)
.superpowers/

# Emacs runtime/build artifacts (package manager output, compiled, caches)
emacs/.emacs.d/eln-cache/
emacs/.emacs.d/elpa/
emacs/.emacs.d/straight/
emacs/.emacs.d/**/*.elc
emacs/.emacs.d/ac-comphist.dat

# Micro editor buffer state
micro/.config/micro/buffers/

# govirt stacks (local dev VM setup — host paths, NFS export config)
govirt/.config/govirt/stacks/

# Claude Code per-machine local settings (permission allowlists, not shared)
**/.claude/settings.local.json

# Stale Claude stow package: live config lives in the standalone ~/claude/claude
# repo (github.com:gherlein/claude.git), symlinked as ~/.claude. Not managed here.
/claude/

# ~/bin (untracked personal scripts, not the repo's scripts/bin)
/bin/
__pycache__/
*.pyc
.venv/
bin/
# The global gitignore-gate hook enforces an unanchored `bin/`; re-include the
# repo's own scripts/bin dir (real tracked scripts). The dir-only negation lets
# *~ backups and **/.claude/settings.local.json stay ignored inside it.
!scripts/bin/
# Captured ONVIF response — contains camera UsernameToken/PasswordDigest.
scripts/bin/reo1-eventprops.xml
