#!/usr/bin/env bash
# Copy the currently-focused herdr pane's terminal output to the Wayland
# clipboard.
#
# WHY ask herdr for the focused pane instead of reading $HERDR_PANE_ID: kitty
# launches this script as a child of kitty, not of the process inside the herdr
# pane, so it does not inherit HERDR_PANE_ID. `herdr pane current` returns the
# pane the user actually has focused, which is what we want to copy.
#
# Usage: herdr-copy-pane [source]
#   source is a herdr `pane read` snapshot source; defaults to recent-unwrapped
#   (full recent output with soft-wrapped lines joined, best for pasting).
set -euo pipefail

source="${1:-recent-unwrapped}"

pane="$(herdr pane current | jq -r '.result.pane.pane_id')"
if [ -z "$pane" ] || [ "$pane" = "null" ]; then
	exit 1
fi

herdr pane read "$pane" --source "$source" --format text | wl-copy
