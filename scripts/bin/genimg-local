#!/usr/bin/env bash
set -euo pipefail

# genimg-local - generate an image locally via OpenVINO GenAI on the Intel iGPU
# Usage: genimg-local [options] "your prompt" [output_file]
#
# Runs a quantized LCM (Latent Consistency Model) Stable Diffusion pipeline
# through OpenVINO on the Intel GPU (OpenCL/Level-Zero) instead of a paid API.
# No network calls, no per-image cost.
#
# Setup (already done once):
#   uv venv --python 3.12 ~/.venvs/openvino-genai
#   source ~/.venvs/openvino-genai/bin/activate
#   uv pip install openvino openvino-genai "optimum-intel[openvino]" diffusers \
#       huggingface_hub
#   optimum-cli export openvino --model SimianLuo/LCM_Dreamshaper_v7 \
#       --weight-format fp16 --task text-to-image \
#       ~/.cache/genimg-local/lcm-dreamshaper-v7-fp16
#
# To use a different model, export it the same way and point
# GENIMG_LOCAL_MODEL at the new directory.

VENV="${GENIMG_LOCAL_VENV:-$HOME/.venvs/openvino-genai}"
MODEL="${GENIMG_LOCAL_MODEL:-$HOME/.cache/genimg-local/lcm-dreamshaper-v7-fp16}"
DEVICE="${GENIMG_LOCAL_DEVICE:-GPU}"
VALID_FORMATS="webp jpg png"

WIDTH=512
HEIGHT=512
STEPS=4
GUIDANCE=1.0
FORMAT=""

die() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  cat >&2 <<EOF
usage: genimg-local [options] <prompt> [output_file]

  prompt       Text description of the image to generate
  output_file  Where to save the image (default: prompted interactively)
               Format is inferred from extension (.webp, .jpg, .png)

options:
  -f FORMAT    Output format: webp, jpg, or png (default: png)
  -W WIDTH     Image width in pixels (default: 512)
  -H HEIGHT    Image height in pixels (default: 512)
  -s STEPS     Inference steps (default: 4, tuned for LCM)
  -g GUIDANCE  Guidance scale (default: 1.0, LCM ignores high values)
  -d DEVICE    OpenVINO device: GPU or CPU (default: GPU)
  -h           Show this help

environment:
  GENIMG_LOCAL_VENV    Python venv with openvino-genai (default: ~/.venvs/openvino-genai)
  GENIMG_LOCAL_MODEL   Path to exported OpenVINO IR model directory
  GENIMG_LOCAL_DEVICE  OpenVINO device override

examples:
  genimg-local "a rainbow corgi"
  genimg-local "a rainbow corgi" corgi.png
  genimg-local -W 768 -H 768 -s 6 "a rainbow corgi" corgi.png
EOF
  exit 1
}

[[ -d "$VENV" ]] || die "venv not found at $VENV (see setup instructions in this script's header)"
[[ -d "$MODEL" ]] || die "model not found at $MODEL (see setup instructions in this script's header)"

while getopts ":f:W:H:s:g:d:h" opt; do
  case $opt in
    f) FORMAT="$OPTARG" ;;
    W) WIDTH="$OPTARG" ;;
    H) HEIGHT="$OPTARG" ;;
    s) STEPS="$OPTARG" ;;
    g) GUIDANCE="$OPTARG" ;;
    d) DEVICE="$OPTARG" ;;
    h) usage ;;
    :) die "option -$OPTARG requires an argument" ;;
    \?) die "unknown option: -$OPTARG" ;;
  esac
done
shift $((OPTIND - 1))

if [[ -n "$FORMAT" ]]; then
  valid=0
  for f in $VALID_FORMATS; do
    [[ "$f" == "$FORMAT" ]] && valid=1 && break
  done
  [[ $valid -eq 0 ]] && die "invalid format '$FORMAT'. must be one of: $VALID_FORMATS"
fi

[[ $# -eq 0 ]] && usage

PROMPT="$1"
[[ -z "$PROMPT" ]] && die "prompt cannot be empty"

if [[ $# -ge 2 ]]; then
  OUTFILE="$2"
else
  read -r -p "output filename [out.png]: " OUTFILE
  OUTFILE="${OUTFILE:-out.png}"
fi

ext="${OUTFILE##*.}"
if [[ -z "$FORMAT" ]]; then
  if [[ "$ext" == "$OUTFILE" ]]; then
    FORMAT="png"
    OUTFILE="${OUTFILE}.png"
  else
    ext_lower=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    valid=0
    for f in $VALID_FORMATS; do
      [[ "$f" == "$ext_lower" ]] && valid=1 && FORMAT="$ext_lower" && break
    done
    [[ $valid -eq 0 ]] && die "unrecognised extension '.$ext'. use .webp, .jpg, or .png — or set format with -f"
  fi
else
  current_ext=$(printf '%s' "${OUTFILE##*.}" | tr '[:upper:]' '[:lower:]')
  if [[ "$current_ext" == "$OUTFILE" ]]; then
    OUTFILE="${OUTFILE}.${FORMAT}"
  elif [[ "$current_ext" != "$FORMAT" ]]; then
    base="${OUTFILE%.*}"
    echo "warning: extension .${current_ext} does not match -f ${FORMAT}, saving as ${base}.${FORMAT}" >&2
    OUTFILE="${base}.${FORMAT}"
  fi
fi

if [[ -e "$OUTFILE" ]]; then
  read -r -p "file '$OUTFILE' already exists. overwrite? [y/N] " confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { echo "aborted." >&2; exit 1; }
fi

[[ "$FORMAT" == "jpg" ]] && PIL_FORMAT="JPEG" || PIL_FORMAT=$(printf '%s' "$FORMAT" | tr '[:lower:]' '[:upper:]')

echo "generating on $DEVICE (${WIDTH}x${HEIGHT}, ${STEPS} steps)..." >&2

"$VENV/bin/python3" - "$MODEL" "$DEVICE" "$PROMPT" "$WIDTH" "$HEIGHT" "$STEPS" "$GUIDANCE" "$OUTFILE" "$PIL_FORMAT" <<'PYEOF'
import sys
from PIL import Image
import openvino_genai as ov_genai

model_dir, device, prompt, width, height, steps, guidance, outfile, pil_format = sys.argv[1:10]

pipe = ov_genai.Text2ImagePipeline(model_dir, device)
image = pipe.generate(
    prompt,
    width=int(width),
    height=int(height),
    num_inference_steps=int(steps),
    guidance_scale=float(guidance),
)
Image.fromarray(image.data[0]).save(outfile, format=pil_format)
PYEOF

echo "saved: $OUTFILE" >&2
